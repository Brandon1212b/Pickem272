# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/pickem272

# Server port (required for local / Docker API process)
PORT=8080

# Node environment
NODE_ENV=development

# Frontend (Vite)
# Optional. When the React app is hosted separately from the API
# (e.g. Vercel static + Railway/Render backend), set this to the
# public origin of the API, e.g. https://api.example.com
# VITE_API_BASE_URL=

# Docker Compose only
POSTGRES_PASSWORD=changeme
